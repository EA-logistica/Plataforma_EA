{
  "name": "plataforma-ea",
  "version": "2.0.0",
  "private": true,
  "description": "Mensajería y encargos de Plásticos Nacionales: registro, trazabilidad y análisis de costos.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/payback.mjs && node tests/api.mjs && node tests/frontend.mjs",
    "db:reiniciar": "node backend/db/sembrar.js --forzar",
    "db:importar-sqlite": "node backend/db/importarSqlite.js",
    "db:respaldo": "node backend/db/respaldar.js"
  },
  "imports": {
    "#shared/*": "./shared/*",
    "#data/*": "./data/*"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mongodb": "^7.7.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0"
  }
}
